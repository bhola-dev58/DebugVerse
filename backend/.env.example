# DebugVerse Backend Environment Variables
PORT=8001
HOST=0.0.0.0

# Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# AWS Bedrock / Anthropic Claude Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Supabase Database & Auth Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_or_service_role
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Billing Configuration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_ENTERPRISE_PRICE_ID=price_...

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Redis Distributed Cache
REDIS_URL=redis://localhost:6379/0

# Firebase Service Account
FIREBASE_SERVICE_ACCOUNT_KEY=backend/serviceAccountKey.json
